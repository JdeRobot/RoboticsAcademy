    "@eslint/js": "^9.35.0",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-loader": "^8.2.5",
    "binary-loader": "^0.0.1",
    "css-loader": "^6.7.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "file-loader": "^6.2.0",
