    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "sass": "^1.78.0",
    "sass-loader": "^12.6.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
