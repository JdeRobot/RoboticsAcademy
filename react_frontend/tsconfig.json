{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["./svg.d.ts", "./png.d.ts", "./jpg.d.ts", "./zip.d.ts"],
    "paths": {
      "Assets/*": ["./src/assets/*"],
      "Components/*": ["./src/components/*"],
      "Utils/*": ["./src/utils/*"],
      "Contexts/*": ["./src/contexts/*"],
      "Helpers/*": ["./src/helpers/*"],
      "Icons/*": ["./src/icons/*"],
      "Styles/*": ["./src/styles/*"],
      "Types/*": ["./src/types/*"],
      "Constants/*": ["./src/constants/*"],
      "Api": ["./src/api/index.ts"],
      "Routes": ["./src/routes/index.ts"],
      "exercises": ["./../exercises/*"]
    },
    "rootDirs": ["./src", "./../exercises/"],
    "declaration": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "eslint.config.mts",
    "./../exercises/**/*",
    "svg.d.ts",
    "jpg.d.ts",
    "png.d.ts",
    "zip.d.ts"
  ]
}
