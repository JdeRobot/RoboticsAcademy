{
  "name": "react_frontend",
  "version": "6.1.0",
  "description": "React frontend for Robotics Academy",
  "main": "src/index.tsx",
  "author": "Javier Izquierdo <javizqh@pm.me>",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "webpack --mode development --output-path ./static/react_frontend --watch",
    "build": "webpack --mode production --output-path ./static/react_frontend",
    "test": "cypress open",
    "lint": "eslint src",
    "lint-exercises": "for ex in $(ls ../exercises); do bash -c \"cd ../exercises/$ex/react-components && eslint --fix\" 2>/dev/null ; done",
    "lint-all": "npm run lint && npm run lint-exercises",
    "tailwindcss": "NODE_ENV=production tailwindcss -o src/styles/tailwind.css -m",
    "format": "prettier --write src/**/*.{tsx,ts,html,css} && prettier --write ../exercises/**/*.{tsx,ts,js,html,css}"
  },
  "keywords": [],
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "babel-loader": "^10.1.1",
    "binary-loader": "^0.0.1",
    "css-loader": "^7.1.4",
    "cypress": "^15.18.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "19.2.7",
    "sass": "^1.78.0",
    "sass-loader": "^12.6.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.108.4",
    "webpack-bundle-tracker": "^3.2.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/node": "^26.1.1",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.34",
    "axios": "1.18.1",
    "glob": "^13.0.6",
    "jderobot-commsmanager": "1.1.0",
    "jderobot-ide-interface": "0.3.1",
    "jszip": "^3.10.1",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.4.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
