{
  "name": "react_frontend",
  "version": "6.1.0",
  "description": "React frontend for Robotics Academy",
  "main": "src/index.tsx",
  "author": "Javier Izquierdo <javizqh@pm.me>",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "webpack --mode development --output-path ./static/react_frontend --watch",
    "build": "webpack --mode production --output-path ./static/react_frontend",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src",
    "lint-exercises": "for ex in $(ls ../exercises); do bash -c \"cd ../exercises/$ex/react-components && eslint --fix\" 2>/dev/null ; done",
    "lint-all": "npm run lint && npm run lint-exercises",
    "tailwindcss": "NODE_ENV=production tailwindcss -o src/styles/tailwind.css -m",
    "format": "prettier --write src/**/*.{tsx,ts,html,css} && prettier --write ../exercises/**/*.{tsx,ts,js,html,css}"
  },
  "keywords": [],
  "devDependencies": {
